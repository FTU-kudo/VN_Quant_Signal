# ==============================================================================
# .gitignore — vn-quant-signal (Security Hardened for Public GitHub Repo)
# ==============================================================================

# ── 1. Secrets & Credentials (NEVER COMMIT) ─────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.token

# ── 2. Heavy Data & Local Databases ─────────────────────────────────────────
/data/
logs/
*.parquet
*.sqlite
*.db

# ── 3. Python Runtime & Virtual Environments ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
.venv/
venv/
env/
dist/
build/

# ── 4. IDE / Editor Workspace Files ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── 5. Scratch & Personal Files ─────────────────────────────────────────────
scratch/
journal/
