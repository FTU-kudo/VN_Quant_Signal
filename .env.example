# ── Email delivery (Step 6) ───────────────────────────────────────────────────
# Copy this file to .env and fill in real credentials.
# NEVER commit .env to git (it's listed in .gitignore).

# Dán API Key / Token của bạn thay thế cho chữ your_api_key_here bên dưới (không cần dấu ngoặc kép):
# Khóa này giúp tăng tốc độ tải dữ liệu từ 5-8 lần, mở rộng rate limit x5 và ẩn toàn bộ thông báo quảng cáo.
VNSTOCK_API_KEY=your_vnstock_api_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16char_app_password    # Google: myaccount.google.com → App passwords

# Comma-separated list of report recipients
REPORT_RECIPIENTS=analyst@yuanta.com,risk@yuanta.com

# Bot Telegram
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id